{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/session/start.py":   { "maxDuration": 30 },
    "api/session/message.py": { "maxDuration": 30 },
    "api/session/end.py":     { "maxDuration": 60 }
  }
}
